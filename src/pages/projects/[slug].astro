---
import Layout from '../../layouts/Layout.astro';
import { projects, projectUrl, formatDate } from '../../lib/projects.js';
export function getStaticPaths() {
  return projects.map(project => ({ params: { slug: project.slug }, props: { project } }));
}
const { project } = Astro.props;
const related = projects.filter(p => p.slug !== project.slug && p.category === project.category).slice(0,3);
---
<Layout title={project.title+' | ysogabe'} description={project.description}>
  <div class="wrap"><nav class="breadcrumb" aria-label="現在位置"><a href="/">Home</a><span>›</span><a href="/projects/">Projects</a><span>›</span><strong>{project.title}</strong></nav></div>
  <section class="detail-hero wrap">
    <div class="detail-copy">
      <span class="eyebrow">A LITTLE PROJECT STORY</span>
      <div class="detail-category"><span class="detail-icon">{project.icon}</span><span>{project.category}</span></div>
      <h1>{project.title}</h1>
      <h2>{project.subtitle || '気になることを、かたちに。'}</h2>
      <p>{project.description}</p>
      <div class="tag-row detail-tags">{project.tags.map(tag=><span class="soft-tag">{tag}</span>)}</div>
      <div class="hero-actions"><a class="btn btn-primary" href={project.site || project.html_url} target="_blank" rel="noopener noreferrer">{project.site ? '紹介サイトを見る' : 'GitHubで見る'} <span>↗</span></a>{project.site && <a class="btn btn-outline" href={project.html_url} target="_blank" rel="noopener noreferrer">GitHubで見る ↗</a>}</div>
    </div>
    <div class="detail-visual"><div class="detail-visual-inner">{project.image ? <img src={project.image} alt={project.title+' の実際の画面'} referrerpolicy="no-referrer" /> : <div class="detail-fallback"><span>✳</span><strong>{project.icon}</strong><small>making little things</small></div>}</div><span class="detail-visual-flower">✿</span></div>
  </section>
  <section class="wrap detail-sections">
    <article class="detail-panel detail-story">
      <span class="panel-kicker">THE IDEA</span><h2><span class="title-emoji">☘</span> 背景と目的</h2>
      <p>{project.story || '気になったことを、自分の手で試してみる。そんな小さな興味からはじまったプロジェクトです。詳しい開発の記録や使い方は、GitHubのREADMEをご覧ください。'}</p>
      <a class="under-link" href={project.html_url} target="_blank" rel="noopener noreferrer">開発の記録を読む ↗</a>
    </article>
    <article class="detail-panel detail-features">
      <span class="panel-kicker">WHAT IT DOES</span><h2><span class="title-emoji">✳</span> できること</h2>
      {project.features.length ? <ul class="feature-list">{project.features.map((feature,index)=><li><span class="feature-bullet">{['☘','◌','✧','❋','✿'][index%5]}</span>{feature}</li>)}</ul> : <p>取り組みの内容や技術情報はGitHubのREADMEにまとめています。</p>}
    </article>
    <article class="detail-panel detail-meta">
      <span class="panel-kicker">PROJECT NOTES</span><h2><span class="title-emoji">◷</span> プロジェクトの情報</h2>
      <dl class="fact-list"><div><dt>分野</dt><dd>{project.category}</dd></div><div><dt>主な言語</dt><dd>{project.language || '—'}</dd></div><div><dt>最終更新</dt><dd>{formatDate(project.updated_at) || 'GitHubで確認'}</dd></div><div><dt>公開先</dt><dd><a href={project.html_url} target="_blank" rel="noopener noreferrer">GitHub ↗</a></dd></div></dl>
    </article>
  </section>
  {related.length > 0 && <section class="section wrap related-section"><div class="section-head"><div><div class="section-kicker">YOU MIGHT LIKE</div><h2>こちらも、ちょっと気になるかも。</h2></div><a href="/projects/" class="under-link">一覧へ戻る ↗</a></div><div class="related-grid">{related.map(p=><a href={projectUrl(p)} class="related-item"><span>{p.icon}</span><div><strong>{p.title}</strong><small>{p.description}</small></div><b>↗</b></a>)}</div></section>}
  <div class="back-projects wrap"><a href="/projects/">← プロジェクト一覧へ戻る</a></div>
</Layout>
